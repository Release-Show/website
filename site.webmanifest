{
  "name": "release.show",
  "short_name": "release.show",
  "description": "Turn GitHub releases, merged PRs and website changes into 30 to 90 second videos. Branded, captioned and ready to post.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8f6f1",
  "theme_color": "#f8f6f1",
  "icons": [
    { "src": "/assets/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/assets/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
