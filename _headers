# Response headers, applied by Cloudflare to the static assets.
# CSS and JS are referenced with a ?v=<content hash> stamped by
# tools/build-dist.sh, so the URL changes whenever the file does.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # Content-Security-Policy, no 'unsafe-inline' anywhere:
  # - script-src: our own JS, the no-js/js class swap in index.html by its sha256
  #   (tools/build-dist.sh fails if it drifts), and Cloudflare Turnstile's api.js.
  # - style-src: our CSS (the former style="" attributes live in
  #   assets/releaseshow-inline.css, tools/csp-inline-styles.py) and Google Fonts'
  #   stylesheet; font-src: the font files it points at.
  # - img-src data: is the inline SVG noise texture in releaseshow.css.
  # - connect-src: the waitlist Worker only. frame-src: the Turnstile challenge.
  # - form-action keeps mailto: for the no-JavaScript email fallback of the form.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-e2g5HkZP+fghbsY1m7moq4GopOo7zRRaAHNyQ2Q7oSI=' https://challenges.cloudflare.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://api.release.show; frame-src https://challenges.cloudflare.com; manifest-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.png
  Cache-Control: public, max-age=604800

/assets/*.svg
  Cache-Control: public, max-age=604800

/assets/img/*
  Cache-Control: public, max-age=604800

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
